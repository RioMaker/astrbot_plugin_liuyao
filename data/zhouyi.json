      "name": "噬嗑",
      "symbol": "䷔",
      "lower_trigram": "震",
      "upper_trigram": "離",
      "binary_bottom_up": "100101",
      "judgment": "亨。利用獄。",
      "lines": [
        "初九：屨校滅趾，无咎。",
        "六二：噬膚滅鼻，无咎。",
        "六三：噬臘肉，遇毒；小吝，无咎。",
        "九四：噬乾胏，得金矢，利艱貞，吉。",
        "六五：噬乾肉，得黃金，貞厲，无咎。",
        "上九：何校滅耳，凶。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/噬嗑",
      "source_revision": 2404997
    },
    {
