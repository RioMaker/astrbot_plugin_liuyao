      "name": "剝",
      "symbol": "䷖",
      "lower_trigram": "坤",
      "upper_trigram": "艮",
      "binary_bottom_up": "000001",
      "judgment": "不利。有攸往。",
      "lines": [
        "初六：剝牀以足，蔑貞凶。",
        "六二：剝牀以辨，蔑貞凶。",
        "六三：剝之，无咎。",
        "六四：剝牀以膚，凶。",
        "六五：貫魚，以宮人寵，无不利。",
        "上九：碩果不食，君子得輿，小人剝廬。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/剝",
      "source_revision": 2404994
    },
    {
      "number": 24,
      "name": "復",
      "symbol": "䷗",
      "lower_trigram": "震",
      "upper_trigram": "坤",
      "binary_bottom_up": "100000",
      "judgment": "亨。出入无疾，朋來无咎。反復其道，七日來復，利有攸往。",
      "lines": [
        "初九：不復遠，无袛悔，元吉。",
        "六二：休復，吉。",
        "六三：頻復，厲无咎。",
        "六四：中行獨復。",
        "六五：敦復，无悔。",
        "上六：迷復，凶，有災眚。用行師，終有大敗，以其國君，凶；至于十年，不克征。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/復",
      "source_revision": 2497162
    },
    {
      "number": 25,
      "name": "无妄",
      "symbol": "䷘",
      "lower_trigram": "震",
      "upper_trigram": "乾",
      "binary_bottom_up": "100111",
      "judgment": "元亨。利貞。其匪正有眚，不利有攸往。",
      "lines": [
        "初九：无妄，往吉。",
        "六二：不耕穫，不菑畬，則利有攸往。",
        "六三：无妄之災，或系之牛，行人之得，邑人之災。",
        "九四：可貞，无咎。",
        "九五：无妄之疾，勿藥有喜。",
        "上九：无妄，行有眚，无攸利。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/无妄",
      "source_revision": 2527352
    },
    {
      "number": 26,
      "name": "大畜",
      "symbol": "䷙",
      "lower_trigram": "乾",
      "upper_trigram": "艮",
      "binary_bottom_up": "111001",
      "judgment": "利貞，不家食吉，利涉大川。",
      "lines": [
        "初九：有厲利已。",
        "九二：輿說輹。",
        "九三：良馬逐，利艱貞。曰閑輿衛，利有攸往。",
        "六四：童牛之牿，元吉。",
        "六五：豶豕之牙，吉。",
        "上九：何天之衢，亨。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/大畜",
      "source_revision": 2405001
    },
    {
      "number": 27,
      "name": "頤",
      "symbol": "䷚",
      "lower_trigram": "震",
      "upper_trigram": "艮",
      "binary_bottom_up": "100001",
      "judgment": "貞吉。觀頤，自求口實。",
      "lines": [
        "初九：舍爾靈龜，觀我朵頤，凶。",
        "六二：顛頤，拂經，于丘頤，征凶。",
        "六三：拂頤，貞凶，十年勿用，无攸利。",
        "六四：顛頤吉，虎視眈眈，其欲逐逐，无咎。",
        "六五：拂經，居貞吉，不可涉大川。",
        "上九：由頤，厲吉，利涉大川。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/頤",
      "source_revision": 2405042
    },
    {
      "number": 28,
      "name": "大過",
      "symbol": "䷛",
      "lower_trigram": "巽",
      "upper_trigram": "兌",
      "binary_bottom_up": "011110",
      "judgment": "棟橈，利有攸往，亨。",
      "lines": [
        "初六：藉用白茅，无咎。",
        "九二：枯楊生稊，老夫得其女妻，无不利。",
        "九三：棟橈，凶。",
        "九四：棟隆，吉。有它吝。",
        "九五：枯楊生華，老婦得其士夫，无咎无譽。",
        "上六：過涉滅頂，凶，无咎。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/大過",
      "source_revision": 2405002
    },
    {
      "number": 29,
      "name": "坎",
      "symbol": "䷜",
      "lower_trigram": "坎",
      "upper_trigram": "坎",
      "binary_bottom_up": "010010",
      "judgment": "有孚，維心亨。行有尚。",
      "lines": [
        "初六：習坎，入于坎窞，凶。",
        "九二：坎有險，求小得。",
        "六三：來之坎坎，險且枕，入于坎窞，勿用。",
        "六四：樽酒簋貳，用缶，納約自牖，終无咎。",
        "九五：坎不盈，祗既平，无咎。",
        "上六：係用徽纆，寘于叢棘，三歲不得，凶。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/坎",
      "source_revision": 2502716
    },
    {
      "number": 30,
      "name": "離",
      "symbol": "䷝",
      "lower_trigram": "離",
      "upper_trigram": "離",
      "binary_bottom_up": "101101",
      "judgment": "利貞。亨。畜牝牛，吉。",
      "lines": [
        "初九：履錯然，敬之无咎。",
        "六二：黃離，元吉。",
        "九三：日昃之離，不鼓缶而歌，則大耋之嗟，凶。",
        "九四：突如其來如，焚如，死如，棄如。",
        "六五：出涕沱若，戚嗟若，吉。",
        "上九：王用出征，有嘉折首，獲匪其醜，无咎。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/離",
      "source_revision": 2528049
    },
    {
      "number": 31,
      "name": "咸",
      "symbol": "䷞",
      "lower_trigram": "艮",
      "upper_trigram": "兌",
      "binary_bottom_up": "001110",
      "judgment": "亨。利貞。取女吉。",
      "lines": [
        "初六：咸其拇。",
        "六二：咸其腓，凶，居吉。",
        "九三：咸其股，執其隨，往吝。",
        "九四：貞吉悔亡，憧憧往來，朋從爾思。",
        "九五：咸其脢，无悔。",
        "上六：咸其輔，頰，舌。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/咸",
      "source_revision": 2404996
    },
    {
      "number": 32,
      "name": "恒",
      "symbol": "䷟",
      "lower_trigram": "巽",
      "upper_trigram": "震",
      "binary_bottom_up": "011100",
      "judgment": "亨，无咎。利貞，利有攸往。",
      "lines": [
        "初六：浚恆，貞凶，无攸利。",
        "九二：悔亡。",
        "九三：不恆其德，或承之羞，貞吝。",
        "九四：田无禽。",
        "六五：恆其德，貞，婦人吉，夫子凶。",
        "上六：振恆，凶。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/恒",
      "source_revision": 2530043
    },
    {
      "number": 33,
      "name": "遯",
      "symbol": "䷠",
      "lower_trigram": "艮",
      "upper_trigram": "乾",
      "binary_bottom_up": "001111",
      "judgment": "亨。小利貞。",
      "lines": [
        "初六：遯尾，厲，勿用有攸往。",
        "六二：執之用黃牛之革，莫之勝說。",
        "九三：系遯，有疾厲，畜臣妾吉。",
        "九四：好遯君子吉，小人否。",
        "九五：嘉遯，貞吉。",
        "上九：肥遯，无不利。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/遯",
      "source_revision": 2405037
    },
    {
      "number": 34,
      "name": "大壯",
      "symbol": "䷡",
      "lower_trigram": "乾",
      "upper_trigram": "震",
      "binary_bottom_up": "111100",
      "judgment": "利貞。",
      "lines": [
        "初九：壯于趾，征凶，有孚。",
        "九二：貞吉。",
        "九三：小人用壯，君子用罔，貞厲。羝羊觸藩，羸其角。",
        "九四：貞吉悔亡，藩決不羸，壯于大輿之輹。",
        "六五：喪羊于易，无悔。",
        "上六：羝羊觸藩，不能退，不能遂，无攸利，艱則吉。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/大壯",
      "source_revision": 2531745
    },
    {
      "number": 35,
      "name": "晉",
      "symbol": "䷢",
      "lower_trigram": "坤",
      "upper_trigram": "離",
      "binary_bottom_up": "000101",
      "judgment": "康侯用錫馬蕃庶，晝日三接。",
      "lines": [
        "初六：晉如，摧如，貞吉。罔孚，裕无咎。",
        "六二：晉如，愁如，貞吉。受茲介福，于其王母。",
        "六三：眾允，悔亡。",
        "九四：晉如鼫鼠，貞厲。",
        "六五：悔亡，失得勿恤，往吉无不利。",
        "上九：晉其角，維用伐邑，厲吉无咎，貞吝。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/晉",
      "source_revision": 2584802
    },
    {
      "number": 36,
      "name": "明夷",
      "symbol": "䷣",
      "lower_trigram": "離",
      "upper_trigram": "坤",
      "binary_bottom_up": "101000",
      "judgment": "利艱貞。",
      "lines": [
        "初九：明夷于飛，垂其翼。君子于行，三日不食，有攸往，主人有言。",
        "六二：明夷，夷于左股，用拯馬壯，吉。",
        "九三：明夷于南狩，得其大首，不可疾貞。",
        "六四：入于左腹，獲明夷之心，于出門庭。",
        "六五：箕子之明夷，利貞。",
        "上六：不明晦，初登于天，后入于地。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/明夷",
      "source_revision": 2531747
    },
    {
      "number": 37,
      "name": "家人",
      "symbol": "䷤",
      "lower_trigram": "離",
      "upper_trigram": "巽",
      "binary_bottom_up": "101011",
      "judgment": "利女貞。",
      "lines": [
        "初九：閑有家，悔亡。",
        "六二：无攸遂，在中饋，貞吉。",
        "九三：家人嗃嗃，悔厲吉；婦子嘻嘻，終吝。",
        "六四：富家，大吉。",
        "九五：王假有家，勿恤。吉。",
        "上九：有孚威如，終吉。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/家人",
      "source_revision": 2405005
    },
    {
      "number": 38,
      "name": "睽",
      "symbol": "䷥",
      "lower_trigram": "兌",
      "upper_trigram": "離",
      "binary_bottom_up": "110101",
      "judgment": "小事吉。",
      "lines": [
        "初九：悔亡，喪馬勿逐，自復；見惡人无咎。",
        "九二：遇主于巷，无咎。",
        "六三：見輿曳，其牛掣，其人天且劓，无初有終。",
        "九四：睽孤，遇元夫，交孚，厲无咎。",
        "六五：悔亡，厥宗噬膚，往何咎。",
        "上九：睽孤， 見豕負涂，載鬼一車， 先張之弧，后說之弧，匪寇婚媾，往遇雨則吉。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/睽",
      "source_revision": 2531978
    },
    {
      "number": 39,
      "name": "蹇",
      "symbol": "䷦",
      "lower_trigram": "艮",
      "upper_trigram": "坎",
      "binary_bottom_up": "001010",
      "judgment": "利西南，不利東北；利見大人，貞吉。",
      "lines": [
        "初六：往蹇，來譽。",
        "六二：王臣蹇蹇，匪躬之故。",
        "九三：往蹇來反。",
        "六四：往蹇來連。",
        "九五：大蹇朋來。",
        "上六：往蹇來碩，吉；利見大人。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/蹇",
      "source_revision": 2405036
    },
    {
      "number": 40,
      "name": "解",
      "symbol": "䷧",
      "lower_trigram": "坎",
      "upper_trigram": "震",
      "binary_bottom_up": "010100",
      "judgment": "利西南，无所往，其來復吉。有攸往，夙吉。",
      "lines": [
        "初六：无咎。",
        "九二：田獲三狐，得黃矢，貞吉。",
        "六三：負且乘，致寇至，貞吝。",
        "九四：解而拇，朋至斯孚。",
        "六五：君子維有解，吉；有孚于小人。",
        "上六：公用射隼，于高墉之上，獲之，无不利。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/解",
      "source_revision": 2405031
    },
    {
      "number": 41,
      "name": "損",
      "symbol": "䷨",
      "lower_trigram": "兌",
      "upper_trigram": "艮",
      "binary_bottom_up": "110001",
      "judgment": "有孚，元吉。无咎，可貞，利有攸往。曷之用？二簋可用享。",
      "lines": [
        "初九：已事遄往，无咎，酌損之。",
        "九二：利貞，征凶，弗損益之。",
        "六三：三人行，則損一人；一人行，則得其友。",
        "六四：損其疾，使遄有喜，无咎。",
        "六五：或益之，十朋之龜弗克違，元吉。",
        "上九：弗損益之，无咎，貞吉，利有攸往，得臣无家。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/損",
      "source_revision": 2405014
    },
    {
      "number": 42,
      "name": "益",
      "symbol": "䷩",
      "lower_trigram": "震",
      "upper_trigram": "巽",
      "binary_bottom_up": "100011",
      "judgment": "利有攸往。利涉大川。",
      "lines": [
        "初九：利用為大作，元吉，无咎。",
        "六二：或益之，十朋之龜弗克違，永貞吉。王用享于帝，吉。",
        "六三：益之用凶事，无咎。有孚中行，告公用圭。",
        "六四：中行，告公從。利用為依遷國。",
        "九五：有孚惠心，勿問元吉。有孚惠我德。",
        "上九：莫益之，或擊之，立心勿恆，凶。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/益",
      "source_revision": 2405025
    },
    {
      "number": 43,
      "name": "夬",
      "symbol": "䷪",
      "lower_trigram": "乾",
      "upper_trigram": "兌",
      "binary_bottom_up": "111110",
      "judgment": "揚于王庭，孚號，有厲，告自邑，不利即戎，利有攸往。",
      "lines": [
        "初九：壯于前趾，往不勝為咎。",
        "九二：惕號，莫夜有戎，勿恤。",
        "九三：壯于頄，有凶。君子夬夬，獨行遇雨，若濡有慍，无咎。",
        "九四：臀无膚，其行次且。牽羊悔亡，聞言不信。",
        "九五：莧陸夬夬，中行无咎。",
        "上六：无號，終有凶。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/夬",
      "source_revision": 2405003
    },
    {
      "number": 44,
      "name": "姤",
      "symbol": "䷫",
      "lower_trigram": "巽",
      "upper_trigram": "乾",
      "binary_bottom_up": "011111",
      "judgment": "女壯，勿用取女。",
      "lines": [
        "初六：系于金柅，貞吉，有攸往，見凶，羸豕孚踟躅。",
        "九二：包有魚，无咎，不利賓。",
        "九三：臀无膚，其行次且，厲，无大咎。",
        "九四：包无魚，起凶。",
        "九五：以杞包瓜，含章，有隕自天。",
        "上九：姤其角，吝，无咎。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/姤",
      "source_revision": 2437487
    },
    {
      "number": 45,
      "name": "萃",
      "symbol": "䷬",
      "lower_trigram": "坤",
      "upper_trigram": "兌",
      "binary_bottom_up": "000110",
      "judgment": "亨。王假有廟，利見大人，亨。利貞。用大牲吉，利有攸往。",
      "lines": [
        "初六：有孚不終，乃亂乃萃，若號一握為笑，勿恤，往无咎。",
        "六二：引吉，无咎，孚乃利用禴。",
        "六三：萃如，嗟如，无攸利，往无咎，小吝。",
        "九四：大吉，无咎。",
        "九五：萃有位，无咎。匪孚，元永貞，悔亡。",
        "上六：齎咨涕洟，无咎。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/萃",
      "source_revision": 2535017
    },
    {
      "number": 46,
      "name": "升",
      "symbol": "䷭",
      "lower_trigram": "巽",
      "upper_trigram": "坤",
      "binary_bottom_up": "011000",
      "judgment": "元亨，用見大人，勿恤，南征吉。",
      "lines": [
        "初六：允升，大吉。",
        "九二：孚乃利用禴，无咎。",
        "九三：升虛邑。",
        "六四：王用亨于岐山，吉无咎。",
        "六五：貞吉，升階。",
        "上六：冥升，利于不息之貞。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/升",
      "source_revision": 2404995
    },
    {
      "number": 47,
      "name": "困",
      "symbol": "䷮",
      "lower_trigram": "坎",
      "upper_trigram": "兌",
      "binary_bottom_up": "010110",
      "judgment": "亨，貞大人吉，无咎，有言不信。",
      "lines": [
        "初六：臀困于株木，入于幽谷，三歲不覿。",
        "九二：困于酒食，朱紱方來，利用亨祀，征凶，无咎。",
        "六三：困于石，據于蒺藜，入于其宮，不見其妻，凶。",
        "九四：來徐徐，困于金車，吝，有終。",
        "九五：劓刖，困于赤紱，乃徐有說，利用祭祀。",
        "上六：困于葛藟，于臲卼，曰動悔。有悔，征吉。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/困",
      "source_revision": 2502714
    },
    {
      "number": 48,
      "name": "井",
      "symbol": "䷯",
      "lower_trigram": "巽",
      "upper_trigram": "坎",
      "binary_bottom_up": "011010",
      "judgment": "改邑不改井，无喪无得，往來井井。汔至亦未繘井。羸其瓶，凶。",
      "lines": [
        "初六：井泥不食，舊井无禽。",
        "九二：井谷射鮒，瓮敝漏。",
        "九三：井渫不食，為我心惻，可用汲，王明，并受其福。",
        "六四：井甃，无咎。",
        "九五：井冽，寒泉食。",
        "上六：井收勿幕，有孚元吉。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/井",
      "source_revision": 2404992
    },
    {
      "number": 49,
      "name": "革",
      "symbol": "䷰",
      "lower_trigram": "離",
      "upper_trigram": "兌",
      "binary_bottom_up": "101110",
      "judgment": "巳日乃孚，元亨。利貞。悔亡。",
      "lines": [
        "初九：鞏用黃牛之革。",
        "六二：巳日乃革之，征吉，无咎。",
        "九三：征凶，貞厲，革言三就，有孚。",
        "九四：悔亡，有孚改命，吉。",
        "九五：大人虎變，未占有孚。",
        "上六：君子豹變，小人革面，征凶，居貞吉。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/革",
      "source_revision": 2674393
    },
    {
      "number": 50,
      "name": "鼎",
      "symbol": "䷱",
      "lower_trigram": "巽",
      "upper_trigram": "離",
      "binary_bottom_up": "011101",
      "judgment": "元吉，亨。",
      "lines": [
        "初六：鼎顛趾，利出否，得妾以其子，无咎。",
        "九二：鼎有實，我仇有疾，不我能即，吉。",
        "九三：鼎耳革，其行塞，雉膏不食，方雨虧悔，終吉。",
        "九四：鼎折足，覆公餗，其形渥，凶。",
        "六五：鼎黃耳金鉉，利貞。",
        "上九：鼎玉鉉，大吉，无不利。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/鼎",
      "source_revision": 2106200
    },
    {
      "number": 51,
      "name": "震",
      "symbol": "䷲",
      "lower_trigram": "震",
      "upper_trigram": "震",
      "binary_bottom_up": "100100",
      "judgment": "亨。震來虩虩，笑言啞啞。震驚百里，不喪匕鬯。",
      "lines": [
        "初九：震來虩虩，后笑言啞啞，吉。",
        "六二：震來厲，億喪貝，躋于九陵，勿逐，七日得。",
        "六三：震蘇蘇，震行无眚。",
        "九四：震遂泥。",
        "六五：震往來厲，億无喪，有事。",
        "上六：震索索，視矍矍，征凶。震不于其躬，于其鄰，无咎。婚媾有言。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/震",
      "source_revision": 2560429
    },
    {
      "number": 52,
      "name": "艮",
      "symbol": "䷳",
      "lower_trigram": "艮",
      "upper_trigram": "艮",
      "binary_bottom_up": "001001",
      "judgment": "艮其背，不獲其身，行其庭，不見其人，无咎。",
      "lines": [
        "初六：艮其趾，无咎，利永貞。",
        "六二：艮其腓，不拯其隨，其心不快。",
        "九三：艮其限，列其夤，厲薰心。",
        "六四：艮其身，无咎。",
        "六五：艮其輔，言有序，悔亡。",
        "上九：敦艮，吉。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/艮",
      "source_revision": 2405028
    },
    {
      "number": 53,
      "name": "漸",
      "symbol": "䷴",
      "lower_trigram": "艮",
      "upper_trigram": "巽",
      "binary_bottom_up": "001011",
      "judgment": "女歸吉，利貞。",
      "lines": [
        "初六：鴻漸于干，小子厲，有言，无咎。",
        "六二：鴻漸于磐，飲食衎衎，吉。",
        "九三：鴻漸于陸，夫征不復，婦孕不育，凶；利禦寇。",
        "六四：鴻漸于木，或得其桷，无咎。",
        "九五：鴻漸于陵，婦三歲不孕，終莫之勝，吉。",
        "上九：鴻漸于陸，其羽可用為儀，吉。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/漸",
      "source_revision": 2560535
    },
    {
      "number": 54,
      "name": "歸妹",
      "symbol": "䷵",
      "lower_trigram": "兌",
      "upper_trigram": "震",
      "binary_bottom_up": "110100",
      "judgment": "征凶，无攸利。",
      "lines": [
        "初九：歸妹以娣，跛能履，征吉。",
        "九二：眇能視，利幽人之貞。",
        "六三：歸妹以須，反歸以娣。",
        "九四：歸妹愆期，遲歸有時。",
        "六五：帝乙歸妹，其君之袂，不如其娣之袂良，月幾望，吉。",
        "上六：女承筐无實，士刲羊无血，无攸利。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/歸妹",
      "source_revision": 2511521
    },
    {
      "number": 55,
      "name": "豐",
      "symbol": "䷶",
      "lower_trigram": "離",
      "upper_trigram": "震",
      "binary_bottom_up": "101100",
      "judgment": "亨。王假之，勿憂，宜日中。",
      "lines": [
        "初九：遇其配主，雖旬无咎，往有尚。",
        "六二：豐其蔀，日中見斗，往得疑疾，有孚發若，吉。",
        "九三：豐其沛，日中見沫，折其右肱，无咎。",
        "九四：豐其蔀，日中見斗，遇其夷主，吉。",
        "六五：來章，有慶譽，吉。",
        "上六：豐其屋，蔀其家，窺其戶，闃其无人，三歲不觌，凶。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/豐",
      "source_revision": 2560608
    },
    {
      "number": 56,
      "name": "旅",
      "symbol": "䷷",
      "lower_trigram": "艮",
      "upper_trigram": "離",
      "binary_bottom_up": "001101",
      "judgment": "小亨，旅貞吉。",
      "lines": [
        "初六：旅瑣瑣，斯其所取災。",
        "六二：旅即次，懷其資，得童僕貞。",
        "九三：旅焚其次，喪其童僕，貞厲。",
        "九四：旅于處，得其資斧，我心不快。",
        "六五：射雉一矢亡，終以譽命。",
        "上九：鳥焚其巢，旅人先笑后號咷。喪牛于易，凶。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/旅",
      "source_revision": 2560781
    },
    {
      "number": 57,
      "name": "巽",
      "symbol": "䷸",
      "lower_trigram": "巽",
      "upper_trigram": "巽",
      "binary_bottom_up": "011011",
      "judgment": "小亨。利有攸往。利見大人。",
      "lines": [
        "初六：進退，利武人之貞。",
        "九二：巽在牀下，用史巫紛若，吉无咎。",
        "九三：頻巽，吝。",
        "六四：悔亡，田獲三品。",
        "九五：貞吉悔亡，无不利。无初有終，先庚三日，后庚三日，吉。",
        "上九：巽在牀下，喪其資斧，貞凶。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/巽",
      "source_revision": 2441563
    },
    {
      "number": 58,
      "name": "兌",
      "symbol": "䷹",
      "lower_trigram": "兌",
      "upper_trigram": "兌",
      "binary_bottom_up": "110110",
      "judgment": "亨。利貞。",
      "lines": [
        "初九：和兌，吉。",
        "九二：孚兌，吉，悔亡。",
        "六三：來兌，凶。",
        "九四：商兌，未寧，介疾有喜。",
        "九五：孚于剝，有厲。",
        "上六：引兌。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/兌",
      "source_revision": 2404993
    },
    {
      "number": 59,
      "name": "渙",
      "symbol": "䷺",
      "lower_trigram": "坎",
      "upper_trigram": "巽",
      "binary_bottom_up": "010011",
      "judgment": "亨。王假有廟，利涉大川，利貞。",
      "lines": [
        "初六：用拯馬壯，吉。",
        "九二：渙奔其机，悔亡。",
        "六三：渙其躬，无悔。",
        "六四：渙其群，元吉。渙有丘，匪夷所思。",
        "九五：渙汗其大號，渙王居，无咎。",
        "上九：渙其血，去逖出，无咎。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/渙",
      "source_revision": 2405023
    },
    {
      "number": 60,
      "name": "節",
      "symbol": "䷻",
      "lower_trigram": "兌",
      "upper_trigram": "坎",
      "binary_bottom_up": "110010",
      "judgment": "亨。苦節不可貞。",
      "lines": [
        "初九：不出戶庭，无咎。",
        "九二：不出門庭，凶。",
        "六三：不節若，則嗟若，无咎。",
        "六四：安節，亨。",
        "九五：甘節，吉；往有尚。",
        "上六：苦節，貞凶，悔亡。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/節",
      "source_revision": 2405027
    },
    {
      "number": 61,
      "name": "中孚",
      "symbol": "䷼",
      "lower_trigram": "兌",
      "upper_trigram": "巽",
      "binary_bottom_up": "110011",
      "judgment": "豚魚吉，利涉大川，利貞。",
      "lines": [
        "初九：虞吉，有他不燕。",
        "九二：鳴鶴在陰，其子和之，我有好爵，吾與爾靡之。",
        "六三：得敵，或鼓或罷，或泣或歌。",
        "六四：月几望，馬匹亡，无咎。",
        "九五：有孚攣如，无咎。",
        "上九：翰音登于天，貞凶。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/中孚",
      "source_revision": 2404990
    },
    {
      "number": 62,
      "name": "小過",
      "symbol": "䷽",
      "lower_trigram": "艮",
      "upper_trigram": "震",
      "binary_bottom_up": "001100",
      "judgment": "亨。利貞。可小事，不可大事。飛鳥遺之音，不宜上宜下，大吉。",
      "lines": [
        "初六：飛鳥以凶。",
        "六二：過其祖，遇其妣；不及其君，遇其臣；无咎。",
        "九三：弗過防之，從或戕之，凶。",
        "九四：无咎，弗過遇之。往厲必戒，勿用永貞。",
        "六五：密云不雨，自我西郊，公弋取彼在穴。",
        "上六：弗遇過之，飛鳥離之，凶，是謂災眚。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/小過",
      "source_revision": 2405007
    },
    {
      "number": 63,
      "name": "既濟",
      "symbol": "䷾",
      "lower_trigram": "離",
      "upper_trigram": "坎",
      "binary_bottom_up": "101010",
      "judgment": "亨小。利貞。初吉終亂。",
      "lines": [
        "初九：曳其輪，濡其尾，无咎。",
        "六二：婦喪其茀，勿逐，七日得。",
        "九三：高宗伐鬼方，三年克之，小人勿用。",
        "六四：繻有衣袽，終日戒。",
        "九五：東鄰殺牛，不如西鄰之禴祭，實受其福。",
        "上六：濡其首，厲。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/既濟",
      "source_revision": 2572417
    },
    {
      "number": 64,
      "name": "未濟",
      "symbol": "䷿",
      "lower_trigram": "坎",
      "upper_trigram": "離",
      "binary_bottom_up": "010101",
      "judgment": "亨。小狐汔濟，濡其尾，无攸利。",
      "lines": [
        "初六：濡其尾，吝。",
        "九二：曳其輪，貞吉。",
        "六三：未濟，征凶，利涉大川。",
        "九四：貞吉，悔亡，震用伐鬼方，三年有賞于大國。",
        "六五：貞吉，无悔，君子之光，有孚，吉。",
        "上九：有孚于飲酒，无咎，濡其首，有孚失是。"
      ],
      "extra_lines": [],
      "source_url": "https://zh.wikisource.org/wiki/周易/未濟",
      "source_revision": 2405020
    }
  ]
}
